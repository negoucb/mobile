<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerenciador de Tarefas"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/editTextTarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite uma tarefa"
            android:inputType="textCapSentences" />

        <Button
            android:id="@+id/buttonAdicionar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adicionar tarefa" />

        <Button
            android:id="@+id/buttonBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listar tarefas" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atualizar ou excluir tarefa"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <EditText
            android:id="@+id/editIdTarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID da tarefa"
            android:inputType="number" />

        <EditText
            android:id="@+id/editNovoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Novo título da tarefa"
            android:inputType="textCapSentences" />

        <Button
            android:id="@+id/buttonAtualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atualizar tarefa" />

        <Button
            android:id="@+id/buttonExcluir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Excluir tarefa" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tarefas cadastradas:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/listaResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nenhuma tarefa listada."
            android:textSize="16sp"
            android:paddingTop="12dp" />

    </LinearLayout>

</ScrollView>
